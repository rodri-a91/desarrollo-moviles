# =========================================
# .gitignore para proyecto Ionic + React (Vite) + Capacitor
# =========================================

# --- Dependencias ---
node_modules/

# --- Salida de compilación ---
# Vite compila en dist/. Si tu capacitor.config usa otra carpeta en webDir, cámbiala aquí.
dist/
# Proyectos antiguos con Create React App
build/

# --- Variables de entorno ---
# Vite usa .env.local, .env.development.local, etc. para valores privados
*.local
# Descomenta si guardas secretos en .env (si solo hay valores públicos, puedes subirlo)
# .env

# --- Caché y herramientas ---
.ionic/
.sourcemaps/
.sass-cache/
.eslintcache
.vite/
coverage/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editores ---
# VS Code: se ignora todo salvo la configuración que tiene sentido compartir
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*~

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Capacitor ---
# NO ignores android/ ni ios/: se suben a Git.
# Capacitor crea su propio .gitignore dentro de cada una para lo generado.